{
    "name": "capell-app/inertia-react-adapter",
    "description": "React client adapter for Capell Inertia.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "capell-app/core": "^4.0 || 4.x-dev",
        "capell-app/inertia": "^4.0 || 4.x-dev",
        "spatie/laravel-package-tools": "^1.14.1"
    },
    "autoload": {
        "psr-4": {
            "Capell\\InertiaReactAdapter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Capell\\InertiaReactAdapter\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Capell\\InertiaReactAdapter\\Providers\\InertiaReactAdapterServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "prefer-stable": true,
    "homepage": "https://github.com/capell-app/inertia-react-adapter",
    "keywords": [
        "capell",
        "inertia",
        "react"
    ]
}
