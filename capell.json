{
    "manifest-version": 3,
    "name": "capell-app/inertia-react-adapter",
    "slug": "inertia-react-adapter",
    "displayName": "Capell Inertia React Adapter",
    "kind": "plugin",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "React asset adapter for Capell Inertia pages and package routes.",
    "product": {
        "group": "Capell Frontend",
        "tier": "core",
        "bundle": "frontend"
    },
    "namespace": "Capell\\InertiaReactAdapter",
    "surfaces": ["frontend"],
    "dependencies": {
        "requires": ["capell-app/core", "capell-app/inertia"],
        "supports": [],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": [
            "Capell\\InertiaReactAdapter\\Providers\\InertiaReactAdapterServiceProvider"
        ],
        "admin": [],
        "frontend": []
    },
    "contributes": [],
    "database": {
        "migrations": false,
        "settings": false,
        "requiredTables": []
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": null,
        "doctor": null
    },
    "settings": [],
    "permissions": [],
    "capabilities": ["inertia-adapter-react"],
    "performance": {
        "frontendRenderBudgetMs": 20,
        "adminQueryBudget": 0,
        "cacheTags": ["inertia-react"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": ["site", "locale"],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": false
        }
    },
    "healthChecks": [
        {
            "key": "inertia-react-adapter.package-health",
            "label": "Capell Inertia React adapter is registered.",
            "class": "Capell\\InertiaReactAdapter\\Health\\InertiaReactAdapterHealthCheck",
            "severity": "important",
            "surface": "frontend"
        }
    ],
    "commercial": {
        "proposedLicense": "included",
        "requestedCertification": "first-party",
        "supportPolicy": "standard",
        "privateDocsRequested": false
    },
    "marketplace": {
        "summary": "React adapter for Capell Inertia.",
        "description": "Registers React NPM dependencies and the Capell Inertia React application entrypoint.",
        "screenshots": [],
        "categories": ["frontend", "developer-tools"]
    }
}
